// Release：日用版 SysInfo（D16）。
#include "Shared.xcconfig"

SYSINFO_APP_ID = zone.lyl.sysinfo
PRODUCT_BUNDLE_IDENTIFIER = $(SYSINFO_APP_ID)
INFOPLIST_KEY_CFBundleDisplayName = SysInfo

// 不注入 get-task-allow：xcodebuild build 默认把 Release 也当开发构建注入它，而公证会拒绝带它的产物（D20）。
CODE_SIGN_INJECT_BASE_ENTITLEMENTS = NO
