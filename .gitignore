.DS_Store

# Xcode / SwiftPM build products
/build/
DerivedData/
.build/
.swiftpm/
*.xcarchive
*.xcuserstate
xcuserdata/

# Credentials (notarization keys etc.)
.env
*.p8
*.p12

# Machine-local settings that must not go public (D77): remote host address, private notes
Config/remote.local.mk
CLAUDE.local.md

# Probe outputs contain machine identifiers (serials, MACs, IPs); keep sources only
research/probes/**/*.txt
research/probes/**/*.csv
research/probes/**/*.json
research/probes/**/*.log
research/probes/**/*.gz
# Data dumps (ioreg/diskutil plists) also carry UUIDs; keep probe app Info.plist only
research/probes/**/*.plist
!research/probes/**/Info.plist
*.dSYM/

# Claude Code local state
.claude/*.lock
.claude/settings.local.json
research/probes/gpu-module/out/
research/probes/network-module/out/
research/probes/network-module/build/
research/probes/network-module/net_struct
research/probes/network-module/costbench_net
research/probes/network-module/net_watch
research/probes/network-module/wifi_cost
